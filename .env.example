# Copia este archivo a `.env` y define tus valores. `.env` nunca se versiona
# ni se incluye en la imagen Docker.
#
#   cp .env.example .env

# Contraseña de RStudio Server (usuario: rstudio).
# OBLIGATORIA para el servicio `rstudio`: mínimo 12 caracteres y distinta de
# valores por defecto. Si no es válida, el contenedor no arranca.
# Genera una contraseña aleatoria con:
#   Linux/macOS: openssl rand -base64 24
#   PowerShell : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))
RSTUDIO_PASSWORD=

# Puerto local de RStudio Server (solo accesible desde este equipo).
RSTUDIO_PORT=8787

# Linux/macOS: usa tu UID/GID para que los archivos generados te pertenezcan
# (obtenlos con `id -u` e `id -g`). En Windows no es necesario cambiarlos.
HOST_UID=1000
HOST_GID=1000
